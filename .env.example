# Canva Connect API — https://www.canva.com/developers/
# Create an integration, enable the scopes profile:read, design:meta:read,
# design:content:read and asset:read, and add the redirect URL below.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must match the redirect URL registered in the Canva developer portal,
# e.g. http://127.0.0.1:3000/api/canva/callback in development.
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/canva/callback
# Any long random string — encrypts the Canva tokens stored in the session cookie.
# Generate one with: openssl rand -base64 32
CANVA_TOKEN_SECRET=
